---

<Layout page_name="Projects">
  <section class="projects_section">
    <Heading>My projects</Heading>
    <div class="projects_section-carousel">
      <!-- Showing the projects dinamically -->
      {
        projects.map((project) => {
          return (
            <ProjectCard
              title={project.title}
              description={project.description}
              category={project.category}
              gitlink={project.gitlink}
            >
              <div class="skills__category">
                <div class="skills__list">
                  {project.technologiesUsed.map((tech) => {
                    return (
                      <div class="skill-tag">
                        <img src={tech.icon.src} alt={`Logo of ${tech.name}`} />
                        <span>{tech.name}</span>
                      </div>
                    );
                  })}
                </div>
              </div>
            </ProjectCard>
          );
        })
      }
    </div>
  </section>
</Layout>
