---
interface Props {
  advantages: string[];
  disadvantages: string[];
  title: string;
}

const { advantages, disadvantages, title } = Astro.props;
---

<div class="comparison-container">
  <div class="comparison-header">{title}</div>
  <div class="comparison-body">
    <div class="column advantages">
      <h4>Advantages</h4>
      <ul>
        {
          advantages.map((adv) => (
            <li>
              <svg viewBox="0 0 24 24" class="icon-check">
                <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z" />
              </svg>
              {adv}
            </li>
          ))
        }
      </ul>
    </div>
    <div class="column disadvantages">
      <h4>Disadvantages</h4>
      <ul>
        {
          disadvantages.map((disadv) => (
            <li>
              <svg viewBox="0 0 24 24" class="icon-cross">
                <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
              </svg>
              {disadv}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</div>

<style>
  .comparison-container {
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    overflow: hidden;
    max-width: 800px;
    margin: 20px 0;
    font-family: sans-serif;
  }

  .comparison-header {
    background-color: #3b82f6; /* Updated accent color */
    color: white;
    padding: 12px 16px;
    text-align: center;
    font-size: 1.25rem;
    font-weight: bold;
  }

  .comparison-body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    background-color: white;
  }

  /* Dividing line between columns */
  .comparison-body > div:first-child {
    border-right: 1px solid #e0e0e0;
  }

  .column {
    padding: 20px;
  }

  h4 {
    color: #3b82f6; /* Added accent color to column titles */
    margin-top: 0;
    margin-bottom: 12px;
    font-size: 1.1rem;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  li {
    color: #333;
    font-size: 0.95rem;
    margin-bottom: 8px;
    display: flex;
    align-items: flex-start;
  }

  .icon-check,
  .icon-cross {
    width: 20px;
    height: 20px;
    margin-right: 8px;
    flex-shrink: 0;
    margin-top: 7px;
  }

  .icon-check {
    fill: #43a047;
  }

  .icon-cross {
    fill: #d32f2f;
  }
</style>
