---
const { data, postId } = Astro.props;

const { title, description, readTime, pubDate } = data;
---

<style>
  a {
    text-decoration: none;
    color: var(--text-color);
  }

  .post_preview {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem 0;
    border-left: 4px solid transparent;
    padding-left: 1rem;
    transition: border-color 0.2s ease-in-out;
  }

  .post_preview h3 {
    font-style: normal;
    font-size: 1.5rem;
  }

  .post_preview-info-row {
    display: flex;
    justify-content: space-between;
    color: #6b7280;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  /* 
  .post_preview-info-row h5:last-child {
    color: #3b82f6;
    background-color: #eff6ff;
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
    font-weight: 600;
  } */
  .post_preview p {
    color: #4b5563;
    line-height: 1.6;
    max-width: 75ch;
  }

  .read-more {
    display: inline-block;
    color: #3b82f6;
    font-size: 0.875rem;
    font-weight: 600;
    margin-top: 0.5rem;
    transition: transform 0.2s ease;
  }

  /* Moves the arrow slightly to the right on hover */
  a:hover .read-more {
    transform: translateX(4px);
  }

  a:hover .post_preview h3 {
    color: #2563eb;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
<a href=`/Portfolio/blog/${postId}`>
  <div class="post_preview">
    <h3>{title}</h3>
    <div class="post_preview-info-row">
      <h5>{pubDate.toDateString()}</h5>
      <h5></h5>
      <!-- <h5>{readTime} minutes</h5> -->
    </div>
    <p>{description}</p>
    <span class="read-more">Read article &rarr;</span>
  </div>
</a>
