---
import Paragraph from '../Layout_Components/Paragraph.astro';
import Github_logo from '../../../public/github_logo.svg';
const { title, description, category, gitlink } = Astro.props;
---

<style>
  .project_card {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.75rem;
    background-color: #ffffff;
    border: 1px solid #eaeaea;
    border-radius: 16px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
    width: 100%;
    max-width: 650px;
  }

  .project_card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
  }

  .project_card-info {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  .category {
    padding: 0.25rem 0.85rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: capitalize;
  }

  .low_level {
    background-color: #eff6ff;
    color: #4285f4;
  }

  .web {
    background-color: #f3e8ff;
    color: #9333ea;
  }

  .project_card-info a {
    display: flex;
    align-items: center;
    transition: opacity 0.2s ease;
    color: #111827;
  }

  .project_card-info a:hover {
    opacity: 0.6;
  }

  .project_card-info img {
    width: 1.5rem;
    height: 1.5rem;
  }

  .project_card h3 {
    margin: 0;
    font-size: 1.5rem;
    color: #111827;
    font-weight: 700;
  }

  .project_card p {
    margin: 0;
    color: #555555;
    line-height: 1.6;
    font-size: 1rem;
  }

  .project_card h4 {
    margin: 0;
  }

  @media (max-width: 640px) {
    .project_card {
      padding: 1.25rem;
      gap: 1rem;
    }

    .project_card h3 {
      font-size: 1.25rem;
    }

    .project_card p {
      font-size: 0.9375rem;
    }

    .category {
      font-size: 0.75rem;
      padding: 0.2rem 0.75rem;
    }

    .project_card-info img {
      width: 1.25rem;
      height: 1.25rem;
    }
  }
</style>
<div class="project_card">
  <div class="project_card-info">
    <span class={`category ${category == 'low level' ? 'low_level' : 'web'}`}
      >{category}</span
    >
    <a href={gitlink}>
      <img src={Github_logo.src} alt="Github icon" />
    </a>
  </div>
  <h3>{title}</h3>
  <p>{description}</p>
  <h4>Technologies used</h4>
  <slot />
</div>
